{
  "name": "swap-brackets",
  "version": "0.0.1",
  "publisher": "JacobMcCormack",
  "engines": {
    "vscode": "^1.60.0"
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "license": "MIT",
  "displayName": "Swap Brackets",
  "description": "An extension to swap brackets that wrap code from round brackets '(' to curly '{' and back",
  "categories": [
    "Other"
  ],
  "keywords": [
    "bracket",
    "brackets",
    "bracket swap",
    "bracket swapper",
    "swap",
    "swap brackets"
  ],
  "icon": "./swapBrackets.png",
  "repository": {
    "url": "https://github.com/Moolteepass/Swap-Brackets"
  },
  "activationEvents": [
    "onCommand:swapBrackets.swap"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "swapBrackets.swap",
        "title": "Swap Brackets"
      }
    ],
    "keybindings": [
      {
        "command": "swapBrackets.swap",
        "key": "alt+ctrl+b",
        "mac": "alt+cmd+b",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
